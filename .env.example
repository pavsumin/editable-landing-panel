NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
# Exact HTTPS origin in production
PANEL_SITE_URL=http://localhost:3000
# Optional, random 32+ bytes; rotating ADMIN_PASSWORD revokes sessions
ADMIN_SESSION_SECRET=
# Enable only behind a trusted proxy that overwrites x-forwarded-for
PANEL_TRUST_PROXY=false
# Optional analytics, disabled by default; loaded only after visitor consent
NEXT_PUBLIC_GA_ID=
# Optional AI: direct CLI use or the shared Vercel service; never NEXT_PUBLIC
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Shared service only (not required by ordinary CLI users)
PANEL_AI_ENABLED=false
PANEL_AI_RATE_SECRET=
# Optional alternate shared service URL for CLI users
ELP_AI_URL=
